import { RoadMap, road } from "local/marimay-route-planner/planner";

fn locationNames(): []string {
  return ["Depot", "West Hub", "Central Hub", "East Hub", "Customer"];
}

fn deliveryNetwork(): RoadMap {
  return [
    [road(1, 12.0), road(2, 5.0)],
    [road(0, 12.0), road(2, 3.0), road(3, 7.0)],
    [road(0, 5.0), road(1, 3.0), road(3, 14.0), road(4, 30.0)],
    [road(1, 7.0), road(2, 14.0), road(4, 4.0)],
    [road(2, 30.0), road(3, 4.0)],
  ];
}
