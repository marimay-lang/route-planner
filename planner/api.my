public type Road {
  to: int,
  minutes: f64,
}

public type RoadMap = [][]Road;

public type Route {
  public nodes: []int,
  public totalMinutes: f64,
}

public fn road(to: int, minutes: f64): Road {
  return Road { to, minutes };
}

fn validMap(roads: RoadMap): bool {
  const locationCount = roads.length();
  for outgoing in roads {
    for currentRoad in outgoing {
      if currentRoad.to < 0 || currentRoad.to >= locationCount || currentRoad.minutes < 0.0 {
        return false;
      }
    }
  }
  return true;
}

fn reverse(values: []int): void {
  let left = 0;
  let right = values.length() - 1;
  while left < right {
    const temporary = values[left];
    values[left] = values[right];
    values[right] = temporary;
    left += 1;
    right -= 1;
  }
}

fn buildRoute(previous: []int, distances: []f64, start: int, target: int): Option<Route> {
  let nodes: []int = [];
  let current = target;
  for step in 0..previous.length() {
    const _ = nodes.push(current);
    if current == start {
      reverse(nodes);
      return Some(Route { nodes, totalMinutes: distances[target] });
    }
    current = previous[current];
    if current < 0 {
      return None;
    }
  }
  return None;
}

public fn shortestRoute(roads: RoadMap, start: int, target: int): Option<Route> {
  const locationCount = roads.length();
  if start < 0 || start >= locationCount || target < 0 || target >= locationCount {
    return None;
  }
  if !validMap(roads) {
    return None;
  }
  const infinity = 1.0e300;
  let distances: []f64 = [];
  let previous: []int = [];
  let visited: []bool = [];
  for location in 0..locationCount {
    const _ = distances.push(infinity);
    const _ = previous.push(-1);
    const _ = visited.push(false);
  }
  distances[start] = 0.0;
  for iteration in 0..locationCount {
    let selected = -1;
    for location in 0..locationCount {
      if !visited[location] && (selected == -1 || distances[location] < distances[selected]) {
        selected = location;
      }
    }
    if selected == -1 || distances[selected] == infinity {
      return None;
    }
    if selected == target {
      return buildRoute(previous, distances, start, target);
    }
    visited[selected] = true;
    for currentRoad in roads[selected] {
      const candidate = distances[selected] + currentRoad.minutes;
      if candidate < distances[currentRoad.to] {
        distances[currentRoad.to] = candidate;
        previous[currentRoad.to] = selected;
      }
    }
  }
  return None;
}
