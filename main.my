import { formatF64 } from "std/convert";
import { Error as IoError, println } from "std/io";

import { Route, shortestRoute } from "local/marimay-route-planner/planner";

fn printRoute(route: Route, names: []string): Result<void, IoError> {
  println("Optimal delivery route:")?;
  for const location of route.nodes {
    println(names[location])?;
  }
  println("Total travel time in minutes:")?;
  println(formatF64(route.totalMinutes))?;
  return Ok();
}

fn main(): Result<void, IoError> {
  const names = locationNames();
  const route = match shortestRoute(deliveryNetwork(), 0, 4) {
    case Some(value) => value;
    case None => panic("delivery network has no valid route");
  };
  return printRoute(route, names);
}
